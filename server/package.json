{
  "name": "@eagleeyes/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --external:colyseus --external:@colyseus/schema --external:@colyseus/ws-transport",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.0",
    "@colyseus/ws-transport": "^0.18.4",
    "@eagleeyes/shared": "*",
    "colyseus": "^0.18.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
